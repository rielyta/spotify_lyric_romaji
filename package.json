{
  "name": "lirik-romaji",
  "version": "0.1.0",
  "description": "Ubah lirik Korea, Jepang, dan Mandarin di Spotify Web jadi romanisasi, satu lagu sekaligus.",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-dict.mjs && wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@romanize/korean": "^0.1.3",
    "@sglkc/kuroshiro": "^1.0.1",
    "@sglkc/kuroshiro-analyzer-kuromoji": "^1.0.1",
    "pinyin-pro": "^3.28.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wxt": "^0.20.5"
  }
}
